# ==========================================
# Google AI Studio & Local Environment Config
# ==========================================

# Google Gemini API Key (Vite client side & AI Studio server injection)
# Get key from https://aistudio.google.com/
VITE_GEMINI_API_KEY="MY_GEMINI_API_KEY"
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# App Hosting URL (Injected automatically in Cloud Run / AI Studio runtime)
APP_URL="http://localhost:3000"

# Optional: Supabase Integration (Leave default placeholders to use built-in offline mock store)
VITE_SUPABASE_URL="https://placeholder.supabase.co"
VITE_SUPABASE_ANON_KEY="placeholder-anon-key"
