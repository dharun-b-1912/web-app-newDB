# Port exposed on host (kept away from 80/443/25/465/587/993 email ports & 8080 Flutter dev)
COMPREFACE_PORT=8000

# Keep false since JOY PeopleHR already stores audit/enrolment photos in Supabase Storage (faceattend-private)
SAVE_IMAGES_TO_DB=false
MAX_FILE_SIZE=5MB
MAX_REQUEST_SIZE=10MB
IMG_LENGTH_LIMIT=1024

