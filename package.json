{
  "name": "workforceos-enterprise-hrms",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "dev:all": "node scripts/dev-orchestrator.cjs",
    "gateway": "node scripts/workforce-gateway-agent.cjs",
    "build": "vite build",
    "start": "node server.js",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "tsx src/services/__tests__/runSuite.ts",
    "test:whatsapp": "node scripts/whatsapp-live-console.mjs",
    "test:e2e": "playwright test",
    "test:e2e:core": "playwright test tests/e2e/core-enterprise-modules.spec.ts",
    "test:e2e:vendors": "playwright test tests/company-vendor-access.spec.ts tests/vendor-login.spec.ts",
    "test:e2e:routing": "playwright test tests/e2e/sidebar-routing.spec.ts",
    "test:e2e:vguard": "playwright test tests/e2e/vguard-demo-readiness.spec.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "test:e2e:report": "playwright show-report",
    "test:trace": "playwright show-trace",
    "test:all": "npm run test && npm run test:e2e:core && npm run test:e2e:vendors",
    "test:phase9": "tsx scripts/phase9_independent_production_validator.ts",
    "test:cutover": "tsx scripts/phase10_cutover_smoke_runner.ts",
    "guard:governance": "tsx scripts/governance_guard.ts",
    "audit:schema": "tsx scripts/audit_suite.ts schema",
    "audit:tenant": "tsx scripts/audit_suite.ts tenant",
    "audit:rls": "tsx scripts/audit_suite.ts rls",
    "audit:database": "tsx scripts/audit_suite.ts database",
    "verify:production": "tsx scripts/verify_production_pipeline.ts",
    "distribute:flutter": "node scripts/distribute_flutter.cjs",
    "distribute:flutter:fast": "node scripts/distribute_flutter.cjs --skip-build --skip-tests",
    "supabase": "supabase",
    "supabase:start": "supabase start",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status",
    "supabase:db:push": "supabase db push",
    "supabase:db:pull": "supabase db pull",
    "supabase:functions:serve": "supabase functions serve --env-file .env.local",
    "supabase:functions:deploy": "supabase functions deploy",
    "flutter:web": "powershell -NoProfile -Command \"$env:PATH += ';C:\\Windows\\System32\\WindowsPowerShell\\v1.0'; Set-Location flutter_app; flutter run -d chrome --web-port 8080\"",
    "flutter:logs": "node scripts/flutter-live-logs.mjs"
  },
